{
  "name": "desktop-black-hole",
  "version": "2.1.2",
  "private": true,
  "description": "A native DirectX desktop-undistortion overlay with an Electron/WebGL compatibility implementation.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/warmowinter/vervormde-skerm.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "undistort": "electron . --undistort",
    "smoke": "electron . --smoke-test",
    "smoke:undistort": "electron . --undistort --smoke-test",
    "check": "node --check main.js && node --check preload.js && node --check renderer.js && node --check undistort-renderer.js && node --check undistort-control.js",
    "dist:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\build-portable.ps1",
    "dist:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\build-native.ps1",
    "bench:runtimes": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\benchmark-runtime.ps1"
  },
  "devDependencies": {
    "electron": "43.2.0"
  }
}
