#include <windows.h>

1 RT_MANIFEST "app.manifest"

1 VERSIONINFO
 FILEVERSION 2,1,2,0
 PRODUCTVERSION 2,1,2,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "syh\0"
      VALUE "Author", "syh\0"
      VALUE "Comments", "Original author and publisher: syh\0"
      VALUE "FileDescription", "Vervormde Skerm Native DirectX\0"
      VALUE "FileVersion", "2.1.2\0"
      VALUE "InternalName", "VervormdeSkermNative\0"
      VALUE "LegalCopyright", "Copyright (c) 2026 syh\0"
      VALUE "OriginalFilename", "VervormdeSkermNative.exe\0"
      VALUE "ProductName", "Vervormde Skerm Native\0"
      VALUE "ProductVersion", "2.1.2\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
